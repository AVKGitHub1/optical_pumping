{
  "base_config": "default.json",
  "overrides": {
    "timing.protocol": "continuous",
    "timing.total_duration_ms": 5.0,
    "timing.n_samples": 51
  },
  "workers": 8,
  "title": "Pump/repump intensity vs Raman carrier Rabi (continuous, 5 ms)",
  "axes": [
    {
      "param": [
        "spin_pump.peak_intensity_w_m2",
        "repump.peak_intensity_w_m2"
      ],
      "start": 0.01,
      "stop": 0.3,
      "num": 5,
      "log": true,
      "label": "pump & repump peak intensity (W/m^2)"
    },
    {
      "param": "raman.carrier_rabi_hz",
      "values": [
        1000.0,
        2500.0,
        5000.0,
        10000.0,
        20000.0
      ],
      "label": "carrier Rabi (Hz)"
    }
  ]
}